Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(index|webhook|install|cron_status_sync|cron_broadcast|cron_price_sync)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(index|webhook|install|cron_status_sync|cron_broadcast|cron_price_sync)\.php$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</IfModule>
