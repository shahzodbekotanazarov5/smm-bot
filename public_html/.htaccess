Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(webhook|install|cron_status_sync|cron_broadcast)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(webhook|install|cron_status_sync|cron_broadcast)\.php$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</IfModule>
